# Copy to .env and fill in values: cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────
# Commit currently deployed to Production (7-40 char git hash)
PROD_COMMIT=
# Commit currently deployed to UAT (7-40 char git hash)
UAT_COMMIT=
# Absolute path to the local pnpm monorepo
REPO_PATH=/absolute/path/to/your/repo
# App path inside the repo
APP_PATH=apps/my-app
# Fallback base branch
BRANCH=origin/master

# ── Optional: link the changelog title and offer to comment on Jira tickets ─
# After saving and displaying the changelog, asks whether to post release
# comments. Requires Jira credentials. Re-runs skip tickets that already have
# a comment for the same build URL.
# If empty, prompts for an optional URL after displaying the changelog.
# A URL entered at that point updates the changelog for this run only.
RELEASE_BUILD_URL=

# ── Optional: Jira enrichment (ticket title + status) ──────────────────────
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ── Optional: OpenAI (AI-written "Main areas updated" summary) ─────────────
OPENAI_API_KEY=
