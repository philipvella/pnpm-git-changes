# Copy to .env and fill in values: cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────
# Commit currently deployed to Production (7-40 char git hash)
PROD_COMMIT=
# Commit currently deployed to UAT (7-40 char git hash)
UAT_COMMIT=
# Absolute path to the local pnpm monorepo
REPO_PATH=/absolute/path/to/your/repo
# App path inside the repo
APP_PATH=apps/my-app
# Fallback base branch
BRANCH=origin/master

# ── Optional: makes the changelog title a link to the release build ───────
RELEASE_BUILD_URL=

# ── Optional: post a release comment on every Jira ticket in the changelog ─
# Requires Jira credentials and RELEASE_BUILD_URL. Re-runs skip tickets that
# already have a comment for the same build URL.
JIRA_COMMENT_ON_RELEASE=true

# ── Optional: Jira enrichment (ticket title + status) ──────────────────────
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ── Optional: OpenAI (AI-written "Main areas updated" summary) ─────────────
OPENAI_API_KEY=


